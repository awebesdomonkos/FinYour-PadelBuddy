# Server-side (Vercel env vars, read by api/[...path].ts)
SUPABASE_URL="https://<project-ref>.supabase.co"
# service_role key: server-only, never expose to the browser
SUPABASE_KEY="<service-role-key>"
# anon key: handed to the browser via /api/config
SUPABASE_ANON_KEY="<anon-key>"
ALLOWED_ORIGIN="https://find-your-padel-buddy.vercel.app"

# Optional local-dev shortcut: skips the /api/config fetch
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
